# ===================================================
# NEXT.JS + SUPABASE + PAYLOAD CMS BLOG ENVIRONMENT
# ===================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical base URL where this blog is hosted.
# Used for OpenGraph, Twitter cards, sitemap.xml, robots.txt, and canonical links.
# Example on Vercel: https://blog3-mauve.vercel.app
APP_URL="https://blog3-mauve.vercel.app"

# NEXT_PUBLIC_SUPABASE_URL: Public Supabase project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://andtmfgdyrdyrmsuzcjn.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous API key (safe for browser with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_41GzkOV3yuFvpC8kEl_ZSg_1Ic06kTm"

# SUPABASE_SERVICE_ROLE_KEY: Optional backend service-role key for privileged server ops.
# NEVER expose to browser (do NOT prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=""

# PAYLOAD_SECRET: Secret key used for cryptographic signing of CMS auth tokens & sessions.
# Kept securely on the server.
PAYLOAD_SECRET="sb_publishable_41GzkOV3yuFvpC8kEl_ZSg_1Ic06kTm"

# CMS_ADMIN_PASSWORD: Admin authentication passphrase for the CMS area.
# Default demo credentials: admin@janedoe.com / editorial2026
CMS_ADMIN_PASSWORD="editorial-pass"
